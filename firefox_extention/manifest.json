{
  "manifest_version": 2,
  "name": "Pinterest2Tg",
  "version": "0.1",

  "browser_specific_settings": {
    "gecko": {
      "id": "Pinterest2Tg@sanchos.su"
    }
  },

  "browser_action": {
    "default_title": "Pinterest2Tg"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": [
    "nativeMessaging",
    "*://*.pinterest.com/*",
    "*://*.pinterest.ru/*"
  ]
}